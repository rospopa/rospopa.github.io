# Copy to .env and customize
SESSION_SECRET=change-me-to-a-secure-random-string
DB_PATH=./users.db
PORT=3000
HUNTER_API_KEY= # Hunter.io email verification API key
NUMVERIFY_API_KEY= # Numverify phone validation API key
VERTEX_PROJECT_ID= # Google Cloud project ID for Vertex AI
VERTEX_LOCATION=global # Vertex AI location, usually global for grounded search
VERTEX_MODEL=gemini-2.5-flash # Gemini model supporting Grounding with Google Search
GOOGLE_APPLICATION_CREDENTIALS= # Absolute path to the Vertex service account JSON file
