# Copy to .env and customize
SESSION_SECRET=change-me-to-a-secure-random-string
DB_PATH=./users.db
PORT=3000
HUNTER_API_KEY= # Hunter.io email verification API key
NUMVERIFY_API_KEY= # Numverify phone validation API key
GOOGLE_API_KEY= # Google AI Studio Gemini API key (or use GEMINI_API_KEY)
GOOGLE_AI_MODEL=gemini-2.5-flash # Gemini API model supporting Grounding with Google Search
