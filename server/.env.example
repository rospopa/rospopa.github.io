# Copy to .env and customize
SESSION_SECRET=change-me-to-a-secure-random-string
DATABASE_URL=******host:5432/database
DB_PATH=./users.db
PORT=3000
RESEND_API_KEY= # Resend API key for transactional email
TWILIO_ACCOUNT_SID= # Twilio Account SID for outbound SMS
TWILIO_AUTH_TOKEN= # Twilio Auth Token
TWILIO_PHONE_NUMBER= # Twilio sending number in E.164 format, e.g. +14079724041

# --- Calendar: option A, Google Calendar API via service account (private calendars) ---
# Enable the Google Calendar API in Google Cloud, create a service account, download its
# JSON key, then share your calendar with the address below (See all event details).
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# --- Calendar: option B, plain API key (PUBLIC calendars only) ---
GOOGLE_CALENDAR_API_KEY=

# --- Calendar: option C, secret iCal address (no Google Cloud project needed) ---
GOOGLE_CALENDAR_ICS_URL= # Google Calendar 'Secret address in iCal format' - connects the Calendar tab
GOOGLE_CALENDAR_ID= # Calendar ID (e.g. you@gmail.com). Required for options A/B; optional embed view for C
GOOGLE_CALENDAR_TIME_ZONE= # Optional: IANA time zone, e.g. America/New_York
