# Copy to .env and customize
SESSION_SECRET=change-me-to-a-secure-random-string
DATABASE_URL=******host:5432/database
DB_PATH=./users.db
PORT=3000
RESEND_API_KEY= # Resend API key for transactional email
TWILIO_ACCOUNT_SID= # Twilio Account SID for outbound SMS
TWILIO_AUTH_TOKEN= # Twilio Auth Token
TWILIO_PHONE_NUMBER= # Twilio sending number in E.164 format, e.g. +14079724041
